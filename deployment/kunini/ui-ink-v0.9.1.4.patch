@@ -192,0 +200,17 @@ export class LibraryDetailComponent implements OnInit {
+  setQuickFilter(mode: 'progress' | 'read') {
+    if (!this.filter) return;
+
+    const statements = this.filter.statements.filter(statement => statement.field !== SeriesFilterField.ReadProgress);
+    if (mode === 'progress') {
+      statements.push({field: SeriesFilterField.ReadProgress, comparison: FilterComparison.GreaterThan, value: '0'});
+      statements.push({field: SeriesFilterField.ReadProgress, comparison: FilterComparison.LessThan, value: '100'});
+    } else {
+      statements.push({field: SeriesFilterField.ReadProgress, comparison: FilterComparison.GreaterThanEqual, value: '100'});
+    }
+
+    this.quickFilter.set(mode);
+    this.filter = {...this.filter, statements};
+    this.filterSettings.presetsV2 = this.filter;
+    this.filterUtilityService.updateUrlFromFilter(this.filter).subscribe(() => this.loadPage());
+  }
+
