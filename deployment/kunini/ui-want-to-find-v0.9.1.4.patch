+import {ChangeDetectionStrategy, Component, inject, input, OnInit} from '@angular/core';
+import {NgbActiveModal} from '@ng-bootstrap/ng-bootstrap';
+import {FormControl, FormGroup, ReactiveFormsModule, Validators} from '@angular/forms';
+import {translate, TranslocoDirective} from '@jsverse/transloco';
+import {ToastrService} from '@openng/ngx-toastr';
+import {WantToFind} from '../../../_models/want-to-find/want-to-find';
+import {WantToFindService} from '../../../_services/want-to-find.service';
+import {FormFieldDirective} from '../../../_directives/form-field.directive';
+import {ValidationErrorsComponent} from '../../../shared/_components/validation-errors/validation-errors.component';
+import {modalSaved} from '../../../_models/modal/modal-result';
+
+@Component({
+  selector: 'app-edit-want-to-find-modal',
+  templateUrl: './edit-want-to-find-modal.component.html',
+  changeDetection: ChangeDetectionStrategy.OnPush,
+  imports: [TranslocoDirective, ReactiveFormsModule, FormFieldDirective, ValidationErrorsComponent]
+})
+export class EditWantToFindModalComponent implements OnInit {
+  private readonly activeModal = inject(NgbActiveModal);
+  private readonly service = inject(WantToFindService);
+  private readonly toastr = inject(ToastrService);
+
+  item = input<WantToFind | null>(null);
+
+  formGroup = new FormGroup({
+    title: new FormControl('', {nonNullable: true, validators: [Validators.required, Validators.maxLength(256)]}),
+    authors: new FormControl('', {nonNullable: true, validators: [Validators.maxLength(1024)]}),
+    summary: new FormControl('', {nonNullable: true}),
+    isbn: new FormControl('', {nonNullable: true, validators: [Validators.maxLength(64)]}),
+    externalId: new FormControl('', {nonNullable: true, validators: [Validators.maxLength(256)]}),
+    coverUrl: new FormControl('', {nonNullable: true, validators: [Validators.maxLength(2048)]}),
+    sourceUrl: new FormControl('', {nonNullable: true, validators: [Validators.maxLength(2048)]}),
+    notes: new FormControl('', {nonNullable: true})
+  });
+
+  ngOnInit() {
+    const item = this.item();
+    if (!item) return;
+
+    this.formGroup.setValue({
+      title: item.title,
+      authors: item.authors,
+      summary: item.summary ?? '',
+      isbn: item.isbn ?? '',
+      externalId: item.externalId ?? '',
+      coverUrl: item.coverUrl ?? '',
+      sourceUrl: item.sourceUrl ?? '',
+      notes: item.notes ?? ''
+    });
+  }
+
+  close() {
+    this.activeModal.dismiss();
+  }
+
+  save() {
+    if (this.formGroup.invalid) return;
+
+    const request = {...this.formGroup.getRawValue(), id: this.item()?.id ?? 0};
+    const operation = this.item() ? this.service.update(request) : this.service.create(request);
+    operation.subscribe(saved => {
+      this.toastr.success(translate(this.item() ? 'want-to-find.updated' : 'want-to-find.created'));
+      this.activeModal.close(modalSaved(saved));
+    });
+  }
+}
