+                      </button>
+                      <button ngbDropdownItem type="button" (click)="edit(item)">
+                        <i class="fa fa-pen me-2" aria-hidden="true"></i>{{t('edit')}}
+                      </button>
+                    }
+                    @if (item.sourceUrl) {
